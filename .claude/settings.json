{
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "\"$CLAUDE_PROJECT_DIR/.myloop/engine-rust/target/release/myloop\" hook PreCompact",
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "\"$CLAUDE_PROJECT_DIR/.myloop/engine-rust/target/release/myloop\" hook PreToolUse",
            "type": "command"
          }
        ],
        "matcher": "Read|Bash"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "\"$CLAUDE_PROJECT_DIR/.myloop/engine-rust/target/release/myloop\" hook SessionEnd",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "\"$CLAUDE_PROJECT_DIR/.myloop/engine-rust/target/release/myloop\" hook SessionStart",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "\"$CLAUDE_PROJECT_DIR/.myloop/engine-rust/target/release/myloop\" hook Stop",
            "type": "command"
          }
        ]
      }
    ]
  }
}
